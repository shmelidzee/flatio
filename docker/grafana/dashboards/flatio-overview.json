{
  "title": "Flatio — Overview",
  "uid": "flatio-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "tags": ["flatio"],
  "panels": [
    {
      "id": 1,
      "title": "Sync duration by source (avg)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "flatio-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(flatio_sync_duration_seconds_sum[15m]) / rate(flatio_sync_duration_seconds_count[15m])",
          "legendFormat": "{{source}} {{syncType}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Sync runs by outcome (1h)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "flatio-prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (source, status) (increase(flatio_sync_runs_total[1h]))",
          "legendFormat": "{{source}} {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Active listings per source",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "flatio-prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "flatio_listings_active",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "/api/v1/listings latency (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "flatio-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "http_server_requests_seconds{uri=\"/api/v1/listings\", quantile=\"0.5\"}",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "http_server_requests_seconds{uri=\"/api/v1/listings\", quantile=\"0.95\"}",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "http_server_requests_seconds{uri=\"/api/v1/listings\", quantile=\"0.99\"}",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 5,
      "title": "Notifications sent vs failed",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "flatio-prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(flatio_notifications_sent_total[15m]))",
          "legendFormat": "sent",
          "refId": "A"
        },
        {
          "expr": "sum(rate(flatio_notifications_failed_total[15m]))",
          "legendFormat": "failed",
          "refId": "B"
        }
      ]
    }
  ]
}
