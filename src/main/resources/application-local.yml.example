# Local configuration overrides — copy to application-local.yml and adjust as needed.
# This file IS committed. application-local.yml is git-ignored.

spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/flatio
    username: flatio
    password: flatio_local
  jpa:
    show-sql: true

logging:
  level:
    com.flatio: DEBUG
    org.flywaydb: DEBUG
    org.hibernate.SQL: DEBUG
    org.hibernate.orm.jdbc.bind: TRACE
